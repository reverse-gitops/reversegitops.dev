---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';

const implementations = (await getCollection('implementations')).map(({ id, data }) => ({ ...data, id }));
---

<Layout title="Implementations" description="Known open-source implementations of the Reverse GitOps pattern.">
  <main class="page-main">
    <div class="page-content">
      <h1 class="page-title">Known Implementations</h1>
      <p class="page-lead">
        Open-source projects that implement the Reverse GitOps pattern. A Kubernetes API receives
        what the user wants, a controller writes it to Git, and a GitOps operator deploys it.
      </p>

      {implementations.map((impl) => (
        <div class="impl-card" id={impl.id}>
          <div class="impl-header">
            <h2 class="impl-name">{impl.name}</h2>
            <span class="impl-by">by {impl.by}</span>
          </div>
          {impl.description.map((p) => <p class="impl-desc">{p}</p>)}
          <div class="impl-links">
            <a href={impl.repo} class="impl-link" target="_blank" rel="noopener noreferrer">View on GitHub →</a>
            {impl.links.map((l) => (
              <a href={l.href} class="impl-link secondary" target="_blank" rel="noopener noreferrer">{l.label}</a>
            ))}
          </div>
        </div>
      ))}

      <div class="impl-submit">
        <p>
          Building an implementation?
          Open a PR against <a href="https://github.com/reverse-gitops/reversegitops.dev" target="_blank" rel="noopener noreferrer">reverse-gitops/reversegitops.dev</a> to add it here.
        </p>
      </div>
    </div>
  </main>
</Layout>
