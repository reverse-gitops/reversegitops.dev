---
import Layout from '../layouts/Layout.astro';
import { MapPin, Globe, FileText, Image, Link2, CirclePlay } from 'lucide-astro';
import { getTalks, type LinkKind } from '../lib/talks';

const { upcoming, past } = await getTalks();
const ordered = [...upcoming, ...past];

const slug = (s: string) => s.toLowerCase().replace(/[^a-z0-9]+/g, '-');
const recorded = ordered.filter((t) => t.youtube).length;
const speakers = [...new Set(ordered.map((t) => t.speaker))];
const fmt = (d: string, month: 'long' | 'short') =>
  new Date(`${d}T00:00:00Z`).toLocaleDateString('en-US', { month, day: 'numeric', year: 'numeric', timeZone: 'UTC' });
const linkClass = (kind: LinkKind) => (kind === 'primary' ? 'talk-link' : `talk-link ${kind}`);
const sections = [
  { label: 'Upcoming', status: 'upcoming', items: upcoming },
  { label: 'Past', status: 'past', items: past },
];
---

<Layout title="Talks" description="Conference talks about Reverse GitOps: slides, recordings and upcoming sessions.">
  <main class="page-main">
    <div class="page-content">
      <h1 class="page-title">Talks</h1>

      <div class="talk-filters" hidden>
        <div class="talk-filter-group" role="group" aria-label="Filter by status">
          <button type="button" class="talk-chip" data-filter="status" data-value="" aria-pressed="true">All</button>
          <button type="button" class="talk-chip" data-filter="status" data-value="upcoming" aria-pressed="false">Upcoming ({upcoming.length})</button>
          <button type="button" class="talk-chip" data-filter="status" data-value="past" aria-pressed="false">Past ({past.length})</button>
        </div>
        <div class="talk-filter-group" role="group" aria-label="Filter by speaker">
          <button type="button" class="talk-chip" data-filter="speaker" data-value="" aria-pressed="true">All speakers</button>
          {speakers.map((s) => (
            <button type="button" class="talk-chip" data-filter="speaker" data-value={slug(s)} aria-pressed="false">{s}</button>
          ))}
        </div>
        <div class="talk-filter-group" role="group" aria-label="Filter by recording">
          <button type="button" class="talk-chip" data-filter="recorded" data-value="yes" data-toggle aria-pressed="false">Recorded ({recorded})</button>
        </div>
      </div>

      <table class="talk-index">
        <thead>
          <tr>
            <th scope="col" class="ti-date">Date</th>
            <th scope="col">Talk</th>
            <th scope="col" class="ti-speaker">Speaker</th>
            <th scope="col" class="ti-video">Video</th>
            <th scope="col" class="ti-status">Status</th>
          </tr>
        </thead>
        <tbody>
          {ordered.map((t) => (
            <tr data-status={upcoming.includes(t) ? 'upcoming' : 'past'} data-speaker={slug(t.speaker)} data-recorded={t.youtube ? 'yes' : 'no'}>
              <td class="ti-date">{fmt(t.date, 'short')}</td>
              <td>
                <a href={`#${t.id}`} class="ti-title">{t.title}</a>
                <span class="ti-event">{t.event}<span class="ti-mobile"> · {t.speaker} · {fmt(t.date, 'short')}</span></span>
              </td>
              <td class="ti-speaker">{t.speaker}</td>
              <td class="ti-video">
                {t.youtube && (
                  <a href={`https://www.youtube.com/watch?v=${t.youtube}`} target="_blank" rel="noopener noreferrer" title="Watch the recording on YouTube" aria-label={`Watch ${t.title} on YouTube`}>
                    <CirclePlay size={18} />
                  </a>
                )}
              </td>
              <td class="ti-status">
                <span class:list={['talk-badge', upcoming.includes(t) ? 'upcoming' : 'past']}>{upcoming.includes(t) ? 'Upcoming' : 'Past'}</span>
              </td>
            </tr>
          ))}
          <tr class="ti-empty" hidden><td colspan="5">No talks match these filters.</td></tr>
        </tbody>
      </table>

      {sections.map(({ label, status, items }) => items.length > 0 && (
        <section data-section={status}>
          <h2 class="section-label">{label}</h2>
          {items.map((t) => (
            <article class="talk-card" id={t.id} data-status={status} data-speaker={slug(t.speaker)} data-recorded={t.youtube ? 'yes' : 'no'}>
              <div class="talk-meta">
                <span class="talk-event">{t.event}</span>
                <span class="talk-sep">·</span>
                {t.virtual
                  ? <Globe size={13} style="flex-shrink:0;opacity:0.7" />
                  : <MapPin size={13} style="flex-shrink:0;opacity:0.7" />}
                <span class="talk-date">{[t.place, fmt(t.date, 'long'), status === 'upcoming' && t.schedule].filter(Boolean).join(' · ')}</span>
              </div>
              <h3 class="talk-title">{t.title}</h3>
              <p class="talk-speaker">{t.speaker}</p>
              {t.abstract.map((p) => <p class="talk-desc">{p}</p>)}
              {t.youtube && (
                <div class="talk-video-wrap">
                  <iframe
                    src={`https://www.youtube.com/embed/${t.youtube}`}
                    title={`${t.title} (${t.event})`}
                    loading="lazy"
                    allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                    allowfullscreen
                  ></iframe>
                </div>
              )}
              {t.poster && (
                <a href={t.poster.src} class="talk-poster" target="_blank" rel="noopener noreferrer">
                  <img src={t.poster.src} alt={t.poster.alt} width={t.poster.width} height={t.poster.height} loading="lazy" decoding="async" />
                </a>
              )}
              <div class="talk-links">
                {t.links.map((l) => (
                  <a href={l.href} class={linkClass(l.kind)} target="_blank" rel="noopener noreferrer">
                    {l.kind === 'slides' && <FileText size={14} />}
                    {l.kind === 'poster' && <Image size={14} />}
                    {l.label}
                  </a>
                ))}
                <a href={`#${t.id}`} class="talk-permalink" data-copy-link title="Copy a direct link to this talk">
                  <Link2 size={13} />
                  <span>Copy link</span>
                </a>
              </div>
            </article>
          ))}
        </section>
      ))}
    </div>
  </main>
</Layout>

<script>
  const filters = document.querySelector<HTMLElement>('.talk-filters')!;
  const chips = [...filters.querySelectorAll<HTMLButtonElement>('.talk-chip')];
  const rows = [...document.querySelectorAll<HTMLElement>('.talk-index tbody tr[data-status]')];
  const cards = [...document.querySelectorAll<HTMLElement>('.talk-card')];
  const sections = [...document.querySelectorAll<HTMLElement>('section[data-section]')];
  const empty = document.querySelector<HTMLElement>('.ti-empty')!;
  const head = document.querySelector<HTMLElement>('.talk-index thead')!;
  const keys = ['status', 'speaker', 'recorded'] as const;
  const state: Record<(typeof keys)[number], string> = { status: '', speaker: '', recorded: '' };

  function apply() {
    const match = (el: HTMLElement) => keys.every((k) => !state[k] || el.dataset[k] === state[k]);
    rows.forEach((r) => (r.hidden = !match(r)));
    cards.forEach((c) => (c.hidden = !match(c)));
    sections.forEach((s) => (s.hidden = !s.querySelector('.talk-card:not([hidden])')));
    empty.hidden = rows.some((r) => !r.hidden);
    head.hidden = !empty.hidden;
    chips.forEach((c) => c.setAttribute('aria-pressed', String(state[c.dataset.filter as keyof typeof state] === c.dataset.value)));

    const params = new URLSearchParams();
    keys.forEach((k) => state[k] && params.set(k, state[k]));
    const query = params.toString();
    history.replaceState(null, '', `${location.pathname}${query ? `?${query}` : ''}${location.hash}`);
  }

  // Filters can be shared as ?status=past&speaker=damien-dassieu&recorded=yes
  const params = new URLSearchParams(location.search);
  for (const key of keys) {
    const value = params.get(key) ?? '';
    if (chips.some((c) => c.dataset.filter === key && c.dataset.value === value)) state[key] = value;
  }

  // A direct link to a talk always shows that talk, whatever the filters say.
  const target = location.hash ? document.getElementById(decodeURIComponent(location.hash.slice(1))) : null;
  if (target?.classList.contains('talk-card')) {
    keys.forEach((k) => (state[k] = ''));
  }

  chips.forEach((chip) =>
    chip.addEventListener('click', () => {
      const key = chip.dataset.filter as keyof typeof state;
      const value = chip.dataset.value ?? '';
      // A toggle chip (Recorded) switches its filter off when clicked again.
      state[key] = chip.hasAttribute('data-toggle') && state[key] === value ? '' : value;
      apply();
    }),
  );

  document.querySelectorAll<HTMLAnchorElement>('[data-copy-link]').forEach((link) =>
    link.addEventListener('click', async () => {
      const label = link.querySelector('span')!;
      try {
        await navigator.clipboard.writeText(`${location.origin}${location.pathname}${link.hash}`);
        label.textContent = 'Copied';
        setTimeout(() => (label.textContent = 'Copy link'), 1500);
      } catch {
        // Clipboard unavailable: the anchor still navigates, so the address bar has the link.
      }
    }),
  );

  filters.hidden = false;
  apply();
</script>
