---
import Layout from '../layouts/Layout.astro';
import raw from '../../external/manifesto/README.md?raw';
import { marked } from 'marked';
import { Megaphone } from 'lucide-astro';
import PrincipleDiagram from '../components/PrincipleDiagram.astro';
import { PANELS, readPanel, drawingOf, svgSize, svgAlt } from '../lib/diagrams';

const KUBECON_SCHED_URL = 'https://sched.co/2DY82';
const COZYSUMMIT_URL = 'https://community.cncf.io/events/details/cncf-virtual-project-events-hosted-by-cncf-presents-cozysummit-virtual-2026/';

// external/manifesto is a submodule tracking main; the sync:manifesto script
// moves it to the branch tip and runs from predev and prebuild. Imported via
// Vite ?raw so it is inlined at build time — the prerender entry is bundled
// into dist/, so a runtime path lookup would resolve against the wrong root.

// Strip the H1 title — rendered in the hero
const body = raw.replace(/^#[^#].*\n/, '').trimStart();

let content = marked.parse(body) as string;

// Promote the closing statement to a pull-quote block
content = content.replace(
  /<p>The API comes first\. Git remembers\.<\/p>\s*<p>That is Reverse GitOps\.<\/p>/,
  `<div class="pull-quote">
    <p class="pull-main">The API comes first.<br>Git remembers.</p>
    <p class="pull-sub">That is Reverse GitOps.</p>
  </div>`
);

// Style the opening hook paragraph
content = content.replace(/<p>(GitOps gave us)/, '<p class="lead">$1');

// One panel per principle, each derived wholly from its Excalidraw export:
// size, alt text and the gradient swap all follow the drawing, so editing and
// re-exporting is the entire update. See src/lib/diagrams.ts.
//
// No captions: each drawing carries its own numbered wording, the prose above
// it already makes the point, and llms.txt states the principles for text-only
// readers. A caption would be a fourth telling to keep in step by hand.
const DIAGRAMS = PANELS.map((panel) => {
  const svg = readPanel(panel.file);
  const drawing = drawingOf(svg);

  return {
    heading: panel.heading,
    src: `/diagrams/${panel.slug}.svg`,
    ...svgSize(svg, panel.file),
    alt: svgAlt(drawing),
  };
});

// Mark the end of each principle section — the <hr> that closes it — so the
// panel lands after the prose rather than splitting the heading from it.
DIAGRAMS.forEach(({ heading }, i) => {
  const at = content.indexOf(heading);
  if (at === -1) throw new Error(`manifesto heading not found: ${heading}`);
  const hr = content.indexOf('<hr>', at);
  if (hr === -1) throw new Error(`no <hr> closing the section: ${heading}`);
  content = `${content.slice(0, hr)}<!--rgo-diagram-${i}-->${content.slice(hr)}`;
});

// Split into [html, index, html, index, html, ...] so the panels can be real
// components rather than strings injected through set:html.
const parts = content.split(/<!--rgo-diagram-(\d)-->/);

const apiRes = await fetch('https://api.github.com/repos/reverse-gitops/manifesto');
const repoData = apiRes.ok ? await apiRes.json() : {};
const stars: number = repoData.stargazers_count ?? 0;
---

<Layout>
  <div class="hero">
    <div class="hero-glow"></div>
    <div class="hero-inner">
      <div class="wordmark">
        <span class="w-reverse">Reverse</span><svg class="logo-combine" viewBox="0 0 24 24" fill="none" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <defs>
            <linearGradient id="combine-grad" x1="0" y1="0" x2="1" y2="1">
              <stop offset="0%"   stop-color="#60a5fa" />
              <stop offset="50%"  stop-color="#4493f8" />
              <stop offset="100%" stop-color="#a78bfa" />
            </linearGradient>
          </defs>
          <path d="M17 9 L14 6"                            stroke="#7d8590" />
          <path d="M17 3 L14 6 H19 A2 2 0 0 1 21 8 V10"  stroke="#7d8590" />
          <path d="m7 15 3 3"                              stroke="url(#combine-grad)" />
          <path d="m7 21 3-3H5a2 2 0 0 1-2-2v-2"          stroke="url(#combine-grad)" />
          <rect x="14" y="14" width="7" height="7" rx="1" stroke="url(#combine-grad)" />
          <rect x="3"  y="3"  width="7" height="7" rx="1" stroke="#7d8590" />
        </svg><span class="w-gitops">GitOps</span>
      </div>
      <p class="hero-tagline">API-first. Git-recorded. GitOps deploys.</p>
      <div class="hero-actions">
        <a href="#manifesto" class="hero-cta">Read the manifesto ↓</a>
        <a href="https://github.com/reverse-gitops/manifesto" class="star-badge" target="_blank" rel="noopener noreferrer">
          <svg class="star-icon" viewBox="0 0 16 16" aria-hidden="true"><path d="M8 .25a.75.75 0 0 1 .673.418l1.882 3.815 4.21.612a.75.75 0 0 1 .416 1.279l-3.046 2.97.719 4.192a.751.751 0 0 1-1.088.791L8 12.347l-3.766 1.98a.75.75 0 0 1-1.088-.79l.72-4.194L.818 6.374a.75.75 0 0 1 .416-1.28l4.21-.611L7.327.668A.75.75 0 0 1 8 .25Z"/></svg>
          Star on GitHub
          <span class="star-count">{stars}</span>
        </a>
      </div>
    </div>
  </div>

  <a href="/talks" class="kubecon-banner">
    <Megaphone class="banner-icon" size={16} />
    <span class="banner-sep">·</span>
    <span><span id="speaking-verb">I'm speaking</span> at <strong>Øredev 2026</strong></span>
    <span class="banner-sep">·</span>
    <span class="banner-cta">View talks →</span>
  </a>

  <a href="/talks" class="past-banner">
    <span class="past-banner-label">Also spoke at:</span>
    <strong>Swiss Cloud Native Day 2026</strong>
    <span class="banner-sep">·</span>
    <span>GitOps Needs an API · Bern</span>
  </a>

  <script>
    // Talk: Øredev 2026, Nov 5 2026, 14:55–15:35 CET (13:55–14:35 UTC)
    const talkStart = new Date('2026-11-05T13:55:00Z');
    const talkEnd   = new Date('2026-11-05T14:35:00Z');
    const now = new Date();
    const el = document.getElementById('speaking-verb');
    if (el) {
      if (now >= talkStart && now < talkEnd) {
        el.textContent = "I'm currently speaking";
      } else if (now >= talkEnd) {
        el.textContent = "I've spoken";
      }
      // before the talk: default "I'm speaking" stays
    }
  </script>


  <main id="manifesto">
    <article class="manifesto">
      {
        parts.map((part, i) =>
          i % 2 === 0 ? (
            <Fragment set:html={part} />
          ) : (
            <PrincipleDiagram {...DIAGRAMS[Number(part)]} />
          ),
        )
      }
    </article>
  </main>
</Layout>
